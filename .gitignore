# Python
venv/
__pycache__/
*.pyc
.pytest_cache/

# Node / frontend
frontend/node_modules/
frontend/dist/

# Data — user content never goes to version control
data/
entities/*/face/*
entities/*/voice/*
entities/*/memory/*
entities/*/knowledge/*
!entities/*/face/.gitkeep
!entities/*/voice/.gitkeep
!entities/*/memory/.gitkeep
!entities/*/knowledge/.gitkeep

# Models (large binary downloads, not source)
models/

# Secrets — never committed
.env
*.pem
*.key
config/credentials*

# Editor / OS
.vscode/
.idea/
*.log
Thumbs.db
